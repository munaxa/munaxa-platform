{
  "name": "@axa/platform",
  "version": "0.1.0",
  "private": true,
  "description": "The AXA shared platform foundation: design tokens, product themes, typography, icons, UI components, patterns and templates, plus the engineering standards every product builds against. Single source of truth for Munaxa, Workaxa, Inkaxa and future AXA products. Contains no product terminology and no business logic.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js"
    },
    "./typography": {
      "types": "./dist/typography/index.d.ts",
      "default": "./dist/typography/index.js"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "default": "./dist/themes/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "default": "./dist/icons/index.js"
    },
    "./hooks": {
      "types": "./dist/ui/hooks/index.d.ts",
      "default": "./dist/ui/hooks/index.js"
    },
    "./patterns": {
      "types": "./dist/ui/patterns/index.d.ts",
      "default": "./dist/ui/patterns/index.js"
    },
    "./css/tokens": "./tokens/css/primitives.css",
    "./css/motion": "./ui/patterns/motion/motion.css",
    "./css/base": "./themes/base/base.css",
    "./css/themes/group": "./themes/group/index.css",
    "./css/themes/school": "./themes/school/index.css",
    "./css/themes/work": "./themes/work/index.css",
    "./css/themes/docs": "./themes/docs/index.css",
    "./source": "./index.ts"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "tokens/css",
    "themes",
    "ui/patterns/motion/motion.css",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile node_modules/.cache/tsc-typecheck.tsbuildinfo",
    "test": "pnpm run validate",
    "validate:contract": "node scripts/validate-contract.mjs",
    "validate:tokens": "node scripts/validate-tokens.mjs",
    "validate": "pnpm run validate:contract && pnpm run validate:tokens"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@axa/config-eslint": "workspace:*",
    "@axa/config-typescript": "workspace:*",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.17.0",
    "react": "^19.0.0",
    "typescript": "^5.7.3"
  }
}
