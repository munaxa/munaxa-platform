{
  "//": "What actually ships. Stories, tests and tooling configs are excluded so they never reach dist/ or the published type surface.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": []
  },
  "include": [
    "index.ts",
    "tokens/**/*.ts",
    "typography/**/*.ts",
    "themes/**/*.ts",
    "brand/**/*.ts",
    "brand/**/*.tsx",
    "icons/**/*.ts",
    "ui/**/*.ts",
    "ui/**/*.tsx"
  ],
  "exclude": [
    "ui/**/*.test.ts",
    "ui/**/*.test.tsx",
    "ui/**/*.stories.tsx",
    "brand/**/*.test.tsx",
    "brand/**/*.stories.tsx",
    "themes/**/*.test.ts"
  ]
}
