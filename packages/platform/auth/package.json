{
  "name": "@munaxa/auth",
  "version": "2.0.0",
  "description": "Authentication: passwords and policy, login, JWT and refresh tokens with rotation and reuse detection, password reset, MFA, device trust, external identity providers, API keys and machine-to-machine access.",
  "keywords": [
    "security",
    "authentication",
    "mfa",
    "totp",
    "oidc",
    "refresh-tokens"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@munaxa/types": "workspace:^",
    "@munaxa/interfaces": "workspace:^",
    "@munaxa/crypto": "workspace:^"
  },
  "devDependencies": {
    "@munaxa/audit": "workspace:^",
    "@munaxa/cache": "workspace:^",
    "@munaxa/config-eslint": "workspace:*",
    "@munaxa/config-typescript": "workspace:*",
    "@munaxa/rbac": "workspace:^",
    "@munaxa/session": "workspace:^",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munaxa/munaxa-platform.git",
    "directory": "packages/platform/auth"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
