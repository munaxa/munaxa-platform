{
  "name": "@munaxa/licensing",
  "version": "0.0.0",
  "description": "Product-agnostic subscription and licensing contracts: lifecycle states and transitions, entitlement snapshots and their evaluation, signed offline licence documents, outage policy and the audit vocabulary. Holds no key, no table and no product vocabulary.",
  "keywords": [
    "licensing",
    "subscriptions",
    "entitlements",
    "offline-license",
    "multi-tenant"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@munaxa/crypto": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@munaxa/config-eslint": "workspace:*",
    "@munaxa/config-typescript": "workspace:*",
    "eslint": "^9.17.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munaxa/munaxa-platform.git",
    "directory": "packages/platform/licensing"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
