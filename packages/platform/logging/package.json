{
  "name": "@munaxa/logging",
  "version": "1.0.0",
  "description": "Structured, redacting, correlation-aware logging for application, security and performance events.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@munaxa/types": "workspace:^",
    "@munaxa/interfaces": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@munaxa/config-eslint": "workspace:*",
    "@munaxa/config-typescript": "workspace:*",
    "eslint": "^9.17.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munaxa/munaxa-platform.git",
    "directory": "packages/platform/logging"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
