{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "platform-storybook",
  "compatibility_date": "2026-07-30",
  // Static-assets Worker for the Platform documentation site. `pnpm build-storybook`
  // emits a self-contained static bundle to `storybook-static/`; Cloudflare serves it
  // directly, so there is no Worker script — assets only.
  //
  // NOTE: `name` must match the Cloudflare Worker this deploys to (`platform-storybook`).
  // A mismatch does not fail the deploy — wrangler creates a new Worker that no domain
  // points at, and the live site silently keeps its old bundle. The deploy workflow
  // (.github/workflows/deploy-cloudflare.yml) asserts this name before deploying.
  "assets": {
    "directory": "./storybook-static",
    // Storybook deep links live in query params on index.html, and iframe.html is a
    // real file, so nothing here relies on rewrites — the SPA fallback only keeps an
    // unknown path from returning a bare 404.
    "not_found_handling": "single-page-application",
  },
}
