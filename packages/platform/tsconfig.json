{
  "//": "Editor, lint and typecheck config — covers everything, including stories, tests and tooling. Emit is done by tsconfig.build.json, which narrows this to shipped source.",
  "extends": "@axa/config-typescript/react-library.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "index.ts",
    "tokens/**/*.ts",
    "typography/**/*.ts",
    "themes/**/*.ts",
    "icons/**/*.ts",
    "ui/**/*.ts",
    "ui/**/*.tsx",
    "docs/**/*.ts",
    "docs/**/*.tsx",
    "test/**/*.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "vitest.config.ts"
  ]
}
