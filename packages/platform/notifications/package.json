{
  "name": "@munaxa/notifications",
  "version": "2.4.0",
  "description": "Channel-agnostic notification delivery: email, SMS, push and in-app, with templates, providers, retries and a secret-leak guard.",
  "keywords": [
    "security",
    "notifications",
    "email",
    "templates"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@munaxa/types": "workspace:^",
    "@munaxa/interfaces": "workspace:^",
    "@munaxa/crypto": "workspace:^"
  },
  "devDependencies": {
    "@munaxa/config-eslint": "workspace:*",
    "@munaxa/config-typescript": "workspace:*",
    "@munaxa/logging": "workspace:^",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munaxa/munaxa-platform.git",
    "directory": "packages/platform/notifications"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
