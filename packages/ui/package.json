{
  "name": "@munaxa/ui",
  "version": "1.0.0",
  "description": "Munaxa UI — the shared component library: primitives, forms, feedback, navigation, layout, data display, overlays, data grid, patterns, layouts, shell, charts and UI hooks.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./hooks": {
      "types": "./hooks/index.d.ts",
      "default": "./hooks/index.js"
    },
    "./patterns": {
      "types": "./patterns/index.d.ts",
      "default": "./patterns/index.js"
    },
    "./layouts": {
      "types": "./layouts/index.d.ts",
      "default": "./layouts/index.js"
    },
    "./shell": {
      "types": "./shell/index.d.ts",
      "default": "./shell/index.js"
    },
    "./date": {
      "types": "./date/index.d.ts",
      "default": "./date/index.js"
    },
    "./charts": {
      "types": "./charts/index.d.ts",
      "default": "./charts/index.js"
    },
    "./css/motion": "./css/motion.css"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munaxa/munaxa-platform.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "dependencies": {
    "@munaxa/platform": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "scripts": {
    "build": "echo 'buildless façade — nothing to compile' >/dev/null",
    "lint": "echo 'buildless façade — nothing to lint' >/dev/null",
    "typecheck": "echo 'buildless façade — types re-exported from @munaxa/platform' >/dev/null"
  }
}
