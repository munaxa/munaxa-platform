{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CostAndOrganizationVisibility",
      "Effect": "Allow",
      "Action": [
        "ce:Get*",
        "ce:Describe*",
        "ce:List*",
        "budgets:View*",
        "budgets:Describe*",
        "cur:Describe*",
        "freetier:Get*",
        "pricing:*",
        "billing:Get*",
        "billing:List*",
        "invoicing:Get*",
        "invoicing:List*",
        "organizations:Describe*",
        "organizations:List*",
        "servicequotas:Get*",
        "servicequotas:List*",
        "sso:Describe*",
        "sso:List*",
        "identitystore:Describe*",
        "identitystore:List*",
        "cloudtrail:LookupEvents",
        "tag:GetResources",
        "resource-explorer-2:Search",
        "resource-explorer-2:List*",
        "sts:GetCallerIdentity",
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics",
        "cloudwatch:DescribeAlarms"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NeverReadDataSecretsOrLogContents",
      "Effect": "Deny",
      "Action": [
        "secretsmanager:GetSecretValue",
        "ssm:GetParameter*",
        "kms:Decrypt",
        "s3:GetObject*",
        "rds-data:*",
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "logs:GetLogEvents",
        "logs:FilterLogEvents",
        "logs:StartQuery",
        "ecs:ExecuteCommand",
        "ssm:StartSession",
        "secretsmanager:BatchGetSecretValue",
        "kms:GenerateDataKey*",
        "kms:ReEncrypt*",
        "kms:Sign",
        "logs:GetLogRecord",
        "logs:GetQueryResults",
        "logs:StartLiveTail",
        "logs:Unmask",
        "rds:DownloadDBLogFilePortion",
        "rds:DownloadCompleteDBLogFile",
        "lambda:GetFunction",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "athena:GetQueryResults",
        "ec2:GetPasswordData",
        "ec2:GetConsoleOutput",
        "ec2:GetConsoleScreenshot",
        "cloudshell:*",
        "sts:AssumeRole",
        "sts:AssumeRoot",
        "ssm:SendCommand"
      ],
      "Resource": "*"
    }
  ]
}
