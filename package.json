{
  "name": "munaxa-platform",
  "version": "1.0.0",
  "private": true,
  "description": "The Munaxa shared platform: design tokens, product themes, typography, icons, UI components, patterns and layouts. The single source of truth for Munaxa Corporate, School, Work and Docs. Contains no product terminology and no business logic.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "validate": "turbo run validate",
    "storybook": "pnpm --filter @munaxa/platform storybook",
    "build-storybook": "turbo run build-storybook",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@munaxa/config-eslint": "workspace:*",
    "@munaxa/config-typescript": "workspace:*",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "core-js",
      "unrs-resolver",
      "workerd"
    ]
  }
}
