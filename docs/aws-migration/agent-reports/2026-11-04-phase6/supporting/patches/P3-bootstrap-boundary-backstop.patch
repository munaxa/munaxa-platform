diff --git a/infra/aws/bootstrap/iam.tf b/infra/aws/bootstrap/iam.tf
index 0d5fb5a..692763f 100644
--- a/infra/aws/bootstrap/iam.tf
+++ b/infra/aws/bootstrap/iam.tf
@@ -42,7 +42,7 @@ resource "aws_iam_policy" "workload_boundary" {
   path = "/munaxa-shared/"
   policy = jsonencode({
     Version = "2012-10-17"
-    Statement = [
+    Statement = concat([
       {
         Sid      = "EcrSignIn"
         Effect   = "Allow"
@@ -139,7 +139,19 @@ resource "aws_iam_policy" "workload_boundary" {
         NotAction = ["ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer", "ecr:BatchCheckLayerAvailability"]
         Resource  = "arn:aws:ecr:*:*:repository/munaxa-docs/*"
       },
-    ]
+      ], each.key == "nonprod" ? [
+      # Testing's AWS-side shutdown backstop (stack/backstop.tf, phase 6): the scheduler role stops
+      # the nonprod database and scales nonprod services in, nothing else.
+      {
+        Sid    = "TestingBackstop"
+        Effect = "Allow"
+        Action = ["rds:StopDBInstance", "ecs:UpdateService"]
+        Resource = [
+          "arn:aws:rds:${var.region}:${var.account_id}:db:munaxa-${each.key}-*",
+          "arn:aws:ecs:${var.region}:${var.account_id}:service/munaxa-${each.key}/*",
+        ]
+      },
+    ] : [])
   })
 }
 
diff --git a/infra/aws/bootstrap/tests/bootstrap.tftest.hcl b/infra/aws/bootstrap/tests/bootstrap.tftest.hcl
index b394f75..8eb7e7f 100644
--- a/infra/aws/bootstrap/tests/bootstrap.tftest.hcl
+++ b/infra/aws/bootstrap/tests/bootstrap.tftest.hcl
@@ -453,3 +453,22 @@ run "b1_rds_master_secret_only_through_rds" {
     error_message = "N-1: the boundary also admits the RDS master secret by its own environment's tags."
   }
 }
+
+# Phase 6 (Agent 5): the nonprod boundary admits the AWS-side Testing backstop (stack/backstop.tf);
+# prod's does not.
+run "only_the_nonprod_boundary_admits_the_testing_backstop" {
+  command = plan
+
+  assert {
+    condition = length([
+      for s in jsondecode(aws_iam_policy.workload_boundary["nonprod"].policy).Statement : s
+      if s.Sid == "TestingBackstop" && s.Effect == "Allow" && length(setsubtract(s.Action, ["rds:StopDBInstance", "ecs:UpdateService"])) == 0
+    ]) == 1
+    error_message = "The nonprod boundary allows the backstop's stop and scale-in, and nothing more in that statement."
+  }
+
+  assert {
+    condition     = length([for s in jsondecode(aws_iam_policy.workload_boundary["prod"].policy).Statement : s if s.Sid == "TestingBackstop"]) == 0
+    error_message = "Prod has no Testing backstop."
+  }
+}
